# Backend local development (copy to .env and adjust; never commit real secrets)
DJANGO_SECRET_KEY=dev-only-insecure-secret-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty for SQLite; set for Postgres, e.g.:
# DATABASE_URL=postgres://lld:lld-dev-password@localhost:5432/lld
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=0

# Optional LLM evaluation (disabled by default; rule-based evaluator needs no key)
LLM_ENABLED=0
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=20
